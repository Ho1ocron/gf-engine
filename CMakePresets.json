{
    "version": 3,
    "configurePresets": [
        {
            "name": "_libs_provided",
            "displayName": "Provided libs (base preset)",
            "description": "All libs are provided by user",
            "cacheVariables": {
                "GF_LIB_PROVIDED_GLFW": {
                    "type": "BOOL",
                    "value": "ON"
                },
                "GF_LIB_PROVIDED_GLM": {
                    "type": "BOOL",
                    "value": "ON"
                },
                "GF_LIB_PROVIDED_FREETYPE": {
                    "type": "BOOL",
                    "value": "ON"
                }
            }
        },
        {
            "name": "debug",
            "displayName": "Debug",
            "description": "Debug build using default generator (build/)",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "release",
            "displayName": "Release",
            "description": "Release build using default generator (build_release/)",
            "binaryDir": "${sourceDir}/build_release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "debug-ninja",
            "displayName": "Debug-Ninja",
            "description": "Debug build using Ninja generator (build/)",
            "generator": "Ninja",
            "inherits": "debug"
        },
        {
            "name": "release-ninja",
            "displayName": "Release-Ninja",
            "description": "Release build using Ninja generator (build_release/)",
            "generator": "Ninja",
            "inherits": "release"
        }
    ],
    "buildPresets": [
        {
            "name": "debug",
            "configurePreset": "debug"
        },
        {
            "name": "release",
            "configurePreset": "release"
        }
    ]
}
